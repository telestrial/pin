# Copy to e2e/.env.test and fill in. Gitignored.
#
# Two Sia accounts. Identity is a did:dht derived from the Sia recovery
# phrase — there's no Bluesky/atproto login anymore, so the only secret
# per account is its Sia AppKey hex. Bake-once-then-replay: see
# e2e/README.md for the one-time capture that produces *_SIA_KEY_HEX.

ALICE_SIA_KEY_HEX=
# Override only if you're using a non-default indexer.
# ALICE_SIA_INDEXER_URL=https://sia.storage

BOB_SIA_KEY_HEX=
# BOB_SIA_INDEXER_URL=https://sia.storage
