{
  "name": "pin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "PIN_LAN=1 vite",
    "dev:desktop": "bun run build && tauri dev",
    "build": "tsc -b && vite build",
    "wasm": "bash scripts/build-wasm.sh",
    "pkarr": "node scripts/build-pkarr.mjs",
    "preview": "vite preview",
    "check": "biome check .",
    "test": "bun run test:unit && bun run test:int && bun run test:e2e",
    "test:unit": "vitest run --exclude='**/*.int.test.ts' --exclude='**/*.int.test.tsx'",
    "test:int": "vitest run .int.test",
    "test:e2e": "bun run build && playwright test",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@siafoundation/sia-storage": "^0.0.13",
    "@synonymdev/pkarr": "0.1.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "dompurify": "^3.4.1",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^4.1.7",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.7"
  }
}
