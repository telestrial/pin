{
  "name": "pin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:lan": "PIN_LAN=1 bash scripts/dev.sh",
    "dev:relays": "bash scripts/dev-relays.sh",
    "dev:desktop": "bun run build && tauri dev",
    "dev:desktop:pair": "bash scripts/dev-desktop.sh",
    "dev:desktop:trio": "bash scripts/dev-desktop.sh primary b c",
    "build": "tsc -b && vite build",
    "wasm": "bash scripts/build-wasm.sh",
    "preview": "vite preview",
    "check": "biome check .",
    "test": "bun run test:unit && bun run test:int && bun run test:e2e",
    "test:unit": "vitest run --exclude='**/*.int.test.ts' --exclude='**/*.int.test.tsx'",
    "test:int": "vitest run .int.test",
    "test:e2e": "bun run build && playwright test",
    "test:sync": "playwright test --config playwright.sync.config.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "dompurify": "^3.4.15",
    "lucide-react": "^1.47.0",
    "marked": "^18.0.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/ui": "^4.1.11",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
