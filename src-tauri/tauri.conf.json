{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pin",
  "version": "0.1.0",
  "identifier": "tech.sia.pin",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Pin",
        "width": 1280,
        "height": 832,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
